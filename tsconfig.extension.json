{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".",
    "target": "ES2016",
    "moduleResolution": "Node",
    "module": "CommonJS",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/extension/**/*.ts", "src/utils/**/*.ts", "src/types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
